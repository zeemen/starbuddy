{
  "name": "@starbuddy/adapter-wenli",
  "version": "0.1.0",
  "private": true,
  "description": "文砺（语文）学科适配器：实现学科插件 API v0.9 与 v1.0 候选版的 capabilities / grade（作文五维）/ diagnose（原生自适应测评，客观题确定性判分）/ plan（确定性学科处方）",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-reporter=dot tests/*.test.ts",
    "register:sql": "node ../../tools/content-register/wenli.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "5.9.3"
  }
}
