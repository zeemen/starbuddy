{
  "name": "@starbuddy/adapter-aya",
  "version": "0.2.0",
  "private": true,
  "description": "阿鸦（数学）学科适配器：学科插件 API v0.9 的 capabilities / grade / diagnose，v1.0 候选版的六个方法",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-reporter=dot tests/*.test.ts",
    "build:pack": "node --import ./scripts/legacy-loader.ts scripts/build-content-pack.ts",
    "rebuild:pack": "node scripts/rebuild-content-pack.ts",
    "register:sql": "node ../../tools/content-register/aya.ts",
    "mutation": "node --no-warnings scripts/mutations.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "5.9.3"
  }
}
