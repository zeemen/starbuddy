{
  "Version": "1",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "rds:Describe*",
        "log:GetProject", "log:ListProject", "log:GetLogStore", "log:ListLogStores", "log:GetIndex", "log:ListTagResources",
        "log:GetProjectPolicy", "log:GetLogStoreMeteringMode", "log:ListShards",
        "cr:GetInstance", "cr:GetInstanceEndpoint", "cr:GetInstanceVpcEndpoint", "cr:GetNamespace", "cr:GetRepository",
        "cr:ListInstance", "cr:ListInstanceEndpoint", "cr:ListNamespace", "cr:ListRepository",
        "yundun-cloudfirewall:Describe*",
        "ram:Get*", "ram:List*"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBInstance", "rds:ModifyDBInstanceDescription", "rds:ModifyDBInstanceSpec", "rds:ModifyDBInstanceConnectionString",
        "rds:ModifySecurityIps", "rds:ModifyDBInstanceSSL", "rds:ModifyPGHbaConfig", "rds:ModifyParameter",
        "rds:ModifyBackupPolicy", "rds:ModifyDBInstanceDeletionProtection", "rds:ModifyDBInstanceTDE",
        "rds:TagResources", "rds:UntagResources"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "oss:PutBucket", "oss:GetBucket*", "oss:PutBucketAcl", "oss:PutBucketVersioning", "oss:PutBucketEncryption",
        "oss:PutBucketLifecycle", "oss:PutBucketPublicAccessBlock", "oss:PutBucketTagging"
      ],
      "Resource": ["acs:oss:*:*:<业务桶名>"]
    },
    {
      "Effect": "Allow",
      "Action": ["oss:ListBuckets"],
      "Resource": ["acs:oss:*:*:*"]
    },
    {
      "Effect": "Allow",
      "Action": ["oss:ListObjects", "oss:GetBucketInfo"],
      "Resource": ["acs:oss:*:*:<状态桶名>"]
    },
    {
      "Effect": "Allow",
      "Action": ["oss:GetObject", "oss:PutObject"],
      "Resource": ["acs:oss:*:*:<状态桶名>/<状态前缀>/*"]
    },
    {
      "Effect": "Allow",
      "Action": ["ots:GetRow", "ots:PutRow", "ots:UpdateRow", "ots:DeleteRow", "ots:DescribeTable"],
      "Resource": ["acs:ots:cn-beijing:*:instance/<OTS 实例名>/table/<锁表名>"]
    },
    {
      "Effect": "Allow",
      "Action": [
        "log:CreateProject", "log:UpdateProject", "log:CreateLogStore", "log:UpdateLogStore",
        "log:CreateIndex", "log:UpdateIndex", "log:TagResources", "log:UntagResources"
      ],
      "Resource": ["acs:log:cn-beijing:*:project/<日志 Project>", "acs:log:cn-beijing:*:project/<日志 Project>/logstore/app",
                   "acs:log:cn-beijing:*:project/<日志 Project>/logstore/audit"]
    },
    {
      "Effect": "Allow",
      "Action": [
        "cr:CreateNamespace", "cr:UpdateNamespace", "cr:CreateRepository", "cr:UpdateRepository",
        "cr:CreateInstanceVpcEndpointLinkedVpc"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "yundun-cloudfirewall:CreateNatFirewallControlPolicy", "yundun-cloudfirewall:ModifyNatFirewallControlPolicy",
        "yundun-cloudfirewall:ModifyNatFirewallControlPolicyPosition"
      ],
      "Resource": "*"
    }
  ]
}
