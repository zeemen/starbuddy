{
  "title": "StarBuddy staging 总览",
  "uid": "starbuddy-overview",
  "description": "LT-05：服务可用、就绪、请求量、5xx、p95、连接池。只引用 deploy/observability/metrics-inventory.yaml 登记的指标；阈值线为占位，待人签字。",
  "tags": ["starbuddy", "staging", "lt-05"],
  "schemaVersion": 39,
  "editable": true,
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "1m",
  "templating": {"list": [{"name": "datasource", "type": "datasource", "query": "prometheus", "label": "数据源（ARMS Prometheus，由人选择）"}]},
  "panels": [
    {"id": 1, "type": "stat", "title": "采集状态（up）", "gridPos": {"x": 0, "y": 0, "w": 8, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "targets": [{"refId": "A", "expr": "sum by (pod) (up{namespace=\"starbuddy-staging\"})", "legendFormat": "{{pod}}"}]},
    {"id": 2, "type": "stat", "title": "就绪（starbuddy_ready）", "gridPos": {"x": 8, "y": 0, "w": 8, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "targets": [{"refId": "A", "expr": "max by (service) (starbuddy_ready)", "legendFormat": "{{service}}"}]},
    {"id": 3, "type": "stat", "title": "容器重启（30 分钟）", "gridPos": {"x": 16, "y": 0, "w": 8, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "targets": [{"refId": "A", "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"starbuddy-staging\"}[30m]))", "legendFormat": "{{pod}}"}]},
    {"id": 4, "type": "timeseries", "title": "请求量（按服务、状态码类别）", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "targets": [{"refId": "A", "expr": "sum by (service, status_class) (rate(starbuddy_http_requests_total[5m]))", "legendFormat": "{{service}} {{status_class}}"}]},
    {"id": 5, "type": "timeseries", "title": "5xx 比例（按服务；阈值线 5% 为占位）", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "targets": [{"refId": "A", "expr": "sum by (service) (rate(starbuddy_http_requests_total{status_class=\"5xx\"}[5m])) / sum by (service) (rate(starbuddy_http_requests_total[5m]))", "legendFormat": "{{service}}"}]},
    {"id": 6, "type": "timeseries", "title": "p95 时延（按服务）", "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (service, le) (rate(starbuddy_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{service}}"}]},
    {"id": 7, "type": "table", "title": "最慢的路由模板（p95，近 1 小时）", "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "targets": [{"refId": "A", "expr": "topk(10, histogram_quantile(0.95, sum by (service, route, le) (rate(starbuddy_http_request_duration_seconds_bucket[1h]))))", "legendFormat": "{{service}} {{route}}"}]},
    {"id": 8, "type": "timeseries", "title": "连接池（当前 / 空闲 / 上限 / BFF 等待）", "gridPos": {"x": 0, "y": 20, "w": 24, "h": 8},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "targets": [
       {"refId": "A", "expr": "sum by (service) (starbuddy_db_pool_size)", "legendFormat": "{{service}} 当前"},
       {"refId": "B", "expr": "sum by (service) (starbuddy_db_pool_idle)", "legendFormat": "{{service}} 空闲"},
       {"refId": "C", "expr": "sum by (service) (starbuddy_db_pool_max)", "legendFormat": "{{service}} 上限"},
       {"refId": "D", "expr": "sum by (service) (starbuddy_db_pool_waiting)", "legendFormat": "{{service}} 等待"}]},
    {"id": 9, "type": "timeseries", "title": "持久卷剩余比例", "gridPos": {"x": 0, "y": 28, "w": 24, "h": 6},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "targets": [{"refId": "A", "expr": "kubelet_volume_stats_available_bytes{namespace=\"starbuddy-staging\"} / kubelet_volume_stats_capacity_bytes{namespace=\"starbuddy-staging\"}", "legendFormat": "{{persistentvolumeclaim}}"}]}
  ]
}
